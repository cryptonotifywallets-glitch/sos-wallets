# SOS WALLETS Backend Configuration
# Copy this file to ".env" and fill in your values.

# Server port
PORT=3001

# JWT secret for auth tokens — change this to a long random string!
JWT_SECRET=change-this-to-a-long-random-secret-string-please-12345

# Email delivery (Nodemailer SMTP)
# Use Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your@gmail.com, SMTP_PASS=your-app-password
# Use Outlook: SMTP_HOST=smtp.office365.com, SMTP_PORT=587
# Use a service like Brevo/Sendinblue: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=SOS WALLETS
EMAIL_FROM_ADDRESS=

# CORS — the origin of your frontend (where index.html is hosted)
# For local testing: http://localhost:8000
# For GitHub Pages: https://dannielfrazier-debug.github.io
CORS_ORIGIN=*

# Admin account — auto-created on first run. CHANGE THESE!
ADMIN_EMAIL=admin@soswallets.app
ADMIN_PASS=admin123456
